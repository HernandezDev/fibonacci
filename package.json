{
  "name": "fibonacci",
  "private": true,
  "type": "module",
  "scripts": {
    "prepare": "panda codegen",
    "build": "react-router build",
    "dev": "react-router dev",
    "typecheck": "wrangler types && react-router typegen && tsc -b",
    "deploy": "npm run build && wrangler deploy",
    "preview": "npm run build && vite preview",
    "cf-typegen": "wrangler types",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:migrate:prod": "node --env-file-if-exists=.env scripts/confirmar-prod.ts && drizzle-kit migrate --config=drizzle.prod.config.ts",
    "db:der": "npx --yes @liam-hq/cli@0.7.24 erd build --format drizzle --input \"workers/db/*.ts\" --output-dir .der && npx --yes serve@14.2.7 .der",
    "postinstall": "wrangler types"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@hono/zod-validator": "0.9.1",
    "@phosphor-icons/react": "^2.1.10",
    "better-auth": "1.7.18",
    "drizzle-orm": "0.45.4",
    "hono": "4.13.15",
    "isbot": "^5.1.36",
    "pg": "8.23.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router": "^8.5.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.66.0",
    "@pandacss/dev": "^2.4.0",
    "@pandacss/preset-base": "^2.4.0",
    "@pandacss/preset-panda": "^2.4.0",
    "@pandacss/vite": "^2.4.0",
    "@react-router/dev": "^8.5.0",
    "@types/node": "^22.20.5",
    "@types/pg": "8.23.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "drizzle-kit": "0.31.11",
    "typescript": "^5.9.3",
    "vite": "^8.0.3",
    "wrangler": "^4.155.0"
  }
}

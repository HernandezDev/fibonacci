/**
 * For more details on how to configure Wrangler, refer to:
 * https://developers.cloudflare.com/workers/wrangler/configuration/
 */
{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "fibonacci",
	"compatibility_date": "2026-10-23",
	"main": "./workers/app.ts",
	"compatibility_flags": ["nodejs_compat"],
	// Variables públicas. Los secretos (BETTER_AUTH_SECRET, GOOGLE_CLIENT_SECRET)
	// van en el panel o con `wrangler secret put`. Las previews no heredan `vars`.
	"vars": {
		// Público: viaja en la URL de inicio de sesión de Google.
		"GOOGLE_CLIENT_ID": "957642735415-3p8vctcn8vsusuhiqqocfpqbhvn7dsvd.apps.googleusercontent.com"
	},
	// Hyperdrive (fibonacci-db), sin caché. El build (prerender) y Workers Builds
	// exigen una cadena local aunque no consulten la base: `localConnectionString`
	// es solo un relleno sin credenciales. En desarrollo, la cadena real va en
	// CLOUDFLARE_HYPERDRIVE_LOCAL_CONNECTION_STRING_HYPERDRIVE (.env).
	"hyperdrive": [
		{
			"binding": "HYPERDRIVE",
			"id": "aac32d06ed2849528e1aab9e58aea881",
			"localConnectionString": "postgres://usuario:clave@localhost:5432/fibonacci"
		}
	],
	// Las previews (`wrangler preview`) no heredan los bindings: usan
	// fibonacci-db-dev, que apunta a la rama `dev` de Neon, nunca a production.
	// Tampoco heredan `vars` ni secretos: los suyos se cargan con
	// `wrangler preview base-config secret` (BETTER_AUTH_SECRET propio,
	// GOOGLE_CLIENT_SECRET y OAUTH_PROXY_SECRET, el mismo que en producción).
	"previews": {
		"vars": {
			"GOOGLE_CLIENT_ID": "957642735415-3p8vctcn8vsusuhiqqocfpqbhvn7dsvd.apps.googleusercontent.com",
			// Activa el desvío del login por producción (ver workers/auth.ts).
			"OAUTH_PROXY_PRODUCTION_URL": "https://fibonacci.com.ar"
		},
		"hyperdrive": [
			{ "binding": "HYPERDRIVE", "id": "ea6dfb7cd7de4fabb822e9d421f6bb4b" }
		]
	},
	// Hyperdrive no acerca el Worker a la base: Neon está en AWS sa-east-1.
	// También aplica a las previews.
	"placement": { "region": "aws:sa-east-1" },
	"observability": {
		"enabled": true,
		"traces": { "enabled": true, "head_sampling_rate": 0.01 }
	},
	"upload_source_maps": true
	/**
	 * Bindings
	 * Bindings allow your Worker to interact with resources on the Cloudflare Developer Platform, including
	 * databases, object storage, AI inference, real-time communication and more.
	 * https://developers.cloudflare.com/workers/runtime-apis/bindings/
	 */
	/**
	 * Static Assets
	 * https://developers.cloudflare.com/workers/static-assets/binding/
	 */
	// "assets": {  "directory": "./public/",  "binding": "ASSETS" }
	/**
	 * Service Bindings (communicate between multiple Workers)
	 * https://developers.cloudflare.com/workers/wrangler/configuration/#service-bindings
	 */
	// "services": [  {   "binding": "MY_SERVICE",   "service": "my-service"  } ]
}
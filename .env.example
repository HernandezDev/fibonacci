# Cadena DIRECTA de Neon (sin -pooler), solo para drizzle-kit (db:migrate).
# Formato: postgresql://<usuario>:<password>@<host>/<db>?sslmode=require&channel_binding=require
# Rol con privilegios de owner (crea/altera tablas).
DATABASE_URL=

# Cadena DIRECTA de la rama production, solo para `npm run db:migrate:prod`.
# Mismo formato que arriba, pero apuntando a la rama production.
PROD_DATABASE_URL=

# Desarrollo local: la lee el plugin de Cloudflare. El sufijo es el nombre del
# binding (HYPERDRIVE). La URL debe incluir contraseña. Usar la rama de desarrollo,
# con el rol de mínimo privilegio (no el owner).
CLOUDFLARE_HYPERDRIVE_LOCAL_CONNECTION_STRING_HYPERDRIVE=

# Better Auth (desarrollo local; en producción son secretos del Worker).
# Secreto de al menos 32 caracteres: `openssl rand -base64 32`. Usar uno distinto
# del de producción.
BETTER_AUTH_SECRET=
# Secreto del cliente OAuth de Google Cloud ("Fibonacci - Better Auth"). El ID no
# va acá: es público y está en `vars` de wrangler.jsonc.
GOOGLE_CLIENT_SECRET=
